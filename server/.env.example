# Satark Server Environment Configuration Template
# Copy to .env and configure for local or production use.

# Port on which the Express server listens (default: 5000)
PORT=5000

# Host binding address (default: 127.0.0.1 for local security)
HOST=127.0.0.1

# Allowed client origin for CORS (e.g. Vite dev server or Vercel production URL)
# Supports comma-separated origins (both localhost and 127.0.0.1 for local dev)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Machine Learning Classifier Service Configuration
# Keep ML_ENABLED=false until Python FastAPI service is running with verified model weights
ML_ENABLED=false
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1500
ML_MODEL_NAME=FacebookAI/xlm-roberta-base


