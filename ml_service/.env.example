# ==============================================================================
# Satark ML Microservice Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for local deployment.
# Use loopback binding; runtime tokenizers load only local files.

# Host binding address (strictly loopback for privacy and security)
HOST=127.0.0.1

# Port on which the FastAPI service listens
PORT=8000

# Path to the quantized ONNX model artifact
MODEL_PATH=artifacts/model_quantized.onnx

# Path to the matching local tokenizer directory (remote identifiers are not used)
TOKENIZER_PATH=artifacts/tokenizer

# Optional existing private bundle layout; enable only after bundle verification:
# MODEL_PATH=artifacts/model_dynamic_gemm_fixed.onnx
# TOKENIZER_PATH=artifacts

# Model identifier reported in inference metadata
MODEL_NAME=FacebookAI/xlm-roberta-base

# Maximum sequence length in tokens (SMS/WhatsApp scam messages typically < 100 tokens)
MAX_TOKEN_LENGTH=128

# Maximum characters accepted in request text payload
MAX_TEXT_LENGTH=2000

# Classification decision threshold (for binary SUSPICIOUS probability)
CONFIDENCE_THRESHOLD=0.62

